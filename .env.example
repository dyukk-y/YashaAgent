# Get a token from @BotFather. Never commit the real token.
BOT_TOKEN=

# Optional comma-separated Telegram numeric user IDs for bot-level admin commands.
ADMIN_USER_IDS=

# SQLite path; Docker Compose persists data in ./data by default.
DATABASE_PATH=data/yashaagent.sqlite3
LOG_LEVEL=INFO

# Optional: enables /summary using the OpenAI API. Leave blank to disable AI summaries.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Public HTTPS URL served through a reverse proxy; required to show the Mini App button.
WEBAPP_URL=
WEBAPP_PORT=8080

# Media archive controls: files live on the persistent /data volume in Docker.
MEDIA_PATH=/data/media
MEDIA_MAX_FILE_MB=20
MEDIA_QUOTA_MB=1024
MEDIA_RETENTION_DAYS=365
